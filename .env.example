# Required for cloud accounts, subscriptions, payments, and sync.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OAuth is enabled only when a provider pair and a 32+ character session secret are set.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
NUXT_PUBLIC_WEB_APP_URL=

# Robokassa ResultURL validates SignatureValue with password #2.
ROBOKASSA_PASSWORD_2=
ROBOKASSA_HASH_ALGORITHM=md5
SUBSCRIPTION_DAYS=31

# Email delivery. Prefer SMTP.BZ HTTPS API when VPS cannot reach smtp.bz:587.
SMTP_HOST=connect.smtp.bz
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Core of Life <no-reply@coreoflife.ru>"
SMTP_API_KEY=
SMTP_API_URL=https://api.smtp.bz/v1/smtp/send

# Agent: OpenAI-compatible chat completions.
# On SpaceWeb VPS prefer Cloudflare Workers AI (OpenRouter is WAF-blocked).
# Token: Cloudflare User API Token with Workers AI. Model is Google Gemma 4
# (Workers AI does not host Gemini Pro; that screenshot pricing is paid).
AI_ENGINE=openai
OPENAI_MODEL=@cf/google/gemma-4-26b-a4b-it
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# Optional OpenRouter hop if Workers AI is not used (see deploy/README.md).
OPENROUTER_PROXY_URL=
OPENROUTER_PROXY_SECRET=

# Cloudflare Turnstile guards register, login, password reset, and code resend.
# Create a widget at Cloudflare Dashboard > Turnstile. Leave empty to disable.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

