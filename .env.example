# Required for cloud accounts, email verification, and sync.
# Prefer NUXT_* names so Nitro picks them up at runtime.
NUXT_DATABASE_URL=postgresql://cof:password@127.0.0.1:5432/cof
DATABASE_URL=postgresql://cof:password@127.0.0.1:5432/cof

# OAuth is enabled only when a provider pair and a 32+ character session secret are set.
NUXT_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_YANDEX_CLIENT_ID=
NUXT_YANDEX_CLIENT_SECRET=
NUXT_PUBLIC_WEB_APP_URL=https://cof-board.com

# Password reset / email verification. Use SMTP with SSL 465 or STARTTLS 587.
NUXT_SMTP_HOST=smtp.bz
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM="Core of Life <no-reply@cof-board.com>"

# Required only for `npm run android:bundle`. Keep these outside Git.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
