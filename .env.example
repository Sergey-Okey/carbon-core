# Optional. Without a database, Core of Life runs in local-only mode.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OAuth is enabled only when a provider pair and a 32+ character session secret are set.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
NUXT_PUBLIC_WEB_APP_URL=

# Robokassa ResultURL validates SignatureValue with password #2.
ROBOKASSA_PASSWORD_2=
ROBOKASSA_HASH_ALGORITHM=md5
SUBSCRIPTION_DAYS=31

# Required only for `npm run android:bundle`. Keep these outside Git.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
